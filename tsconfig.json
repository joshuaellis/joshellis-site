{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowJs": true
  },
  "include": [".astro/types.d.ts", "src"],
  "exclude": ["dist", "node_modules", "src/features/HapticCanvas/**"]
}
