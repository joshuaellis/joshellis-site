---
import { ExternalLinkIcon } from '@radix-ui/react-icons'

import Base from '../layouts/Base.astro'

interface Item {
  title: string
  href: string
  description: string
  external?: boolean
}

const SECTIONS: { title: string; items: Item[] }[] = [
  {
    title: 'Projects',
    items: [
      {
        title: 'react-spring',
        href: 'https://react-spring.io',
        external: true,
        description: 'A spring physics based animation library.',
      },
      {
        title: '@react-three/fiber',
        href: 'https://github.com/pmndrs/react-three-fiber',
        external: true,
        description: 'A react renderer for threejs in the browser or native.',
      },
      {
        title: '@react-three/test-renderer',
        href: 'https://github.com/pmndrs/react-three-fiber/tree/master/packages/test-renderer',
        external: true,
        description: 'A react test renderer for threejs in node.',
      },
      {
        title: '@strapi/pack-up',
        href: 'https://github.com/strapi/pack-up',
        external: true,
        description:
          'Simple tools for creating interoperable CJS & ESM packages.',
      },
    ],
  },
  {
    title: 'Experiments',
    items: [
      {
        title: 'MacOS Dock',
        href: '/experiments/macos-dock',
        description: 'November 2022',
      },
      {
        title: 'Theme Toggle',
        href: '/experiments/theme-toggle',
        description: 'September 2022',
      },
      {
        title: 'Circle Wave',
        href: '/experiments/circle-wave',
        description: 'December 2019',
      },
    ],
  },
]

const COMPANIES = [
  ['strapi', 'https://strapi.io'],
  ['companion', 'https://companion.studio'],
  ['sennep', 'https://sennep.com'],
]
---

<Base>
  <main>
    <div class="intro">
      <span class="avatar">
        <img
          src="https://avatars.githubusercontent.com/u/37798644?v=4"
          alt=""
          width="50"
          height="50"
        />
      </span>
      <h1 class="heading t-M">Josh 🤷🏻‍♀️</h1>
    </div>
    <article>
      <section>
        <p class="t-S lede">
          creating free open-source libraries for communities. crafting software
          that brings users joy. special interests in design-systems, components
          APIs and composable architectures.
        </p>
        <p class="t-S lede">
          currently engineering at <a
            class="headline"
            href="https://sanity.io"
            target="_blank"
            rel="noopener noreferrer">sanity</a
          >. previously at {
            COMPANIES.map(([name, href]) => (
              <>
                <a
                  class="headline"
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {name}
                </a>
                {name === 'sennep' ? ' & ' : ', '}
              </>
            ))
          }<a
            class="headline"
            href="https://applied.works"
            target="_blank"
            rel="noopener noreferrer">applied works</a
          >.
        </p>
      </section>
      <section class="section columns">
        {
          SECTIONS.map((section) => (
            <div class="column">
              <h2 class="heading t-XXS muted">{section.title}</h2>
              <dl>
                {section.items.map((item) => (
                  <div class="item">
                    <dt class="heading t-XS">
                      {item.external ? (
                        <a
                          class="link-regular outlink"
                          href={item.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {item.title}
                          <ExternalLinkIcon width={16} />
                        </a>
                      ) : (
                        <a class="link-regular" href={item.href}>
                          {item.title}
                        </a>
                      )}
                    </dt>
                    <dd class="t-XS muted">{item.description}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))
        }
      </section>
      <section class="section">
        <h2 class="heading t-XXS muted">Connect</h2>
        <p class="t-XS connect">
          Reach me at <a
            class="link-regular"
            href="https://twitter.com/_josh_ellis_"
            target="_blank"
            rel="noopener noreferrer">@_josh_ellis_</a
          > or <a class="link-regular" href="mailto:joshua.ellis18@gmail.com"
            >email</a
          >. Alternatively, take a closer look at my work <a
            class="link-regular"
            href="https://github.com/joshuaellis"
            target="_blank"
            rel="noopener noreferrer">@joshuaellis</a
          >
        </p>
      </section>
    </article>
  </main>
</Base>

<style>
  main {
    width: 100%;
    padding: 0 4rem;
    max-width: 80rem;
    margin: 4rem auto 6rem;
  }

  .intro {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .avatar {
    display: inline-flex;
    border-radius: 50%;
    overflow: hidden;
    width: 50px;
    height: 50px;
    background-color: var(--blue);
  }

  .avatar img {
    width: 100%;
    height: 100%;
  }

  p {
    font-weight: 400;
    text-wrap: balance;
  }

  .lede {
    margin-bottom: 2rem;
  }

  .section {
    margin-top: 4rem;
  }

  .columns {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .column {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    width: 100%;
    flex: 1;
  }

  dl {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    margin: 1.5rem 0 0;
    gap: 1rem;
  }

  .item {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  dd {
    margin: 0;
    font-weight: 400;
  }

  .muted {
    opacity: 0.6;
  }

  .connect {
    margin-top: 1.5rem;
  }

  .outlink {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .outlink :global(svg) {
    opacity: 0.4;
    transition: opacity 0.2s ease-in-out;
  }

  @media (hover: hover) {
    .outlink:hover :global(svg) {
      opacity: 0.6;
    }
  }

  .headline {
    position: relative;
  }

  .headline::after {
    position: absolute;
    left: 0;
    content: '';
    width: 100%;
    height: 2px;
    bottom: -1px;
    background-color: var(--blue);
  }

  .headline:hover::after {
    width: 0;
    left: unset;
    right: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .headline::after {
      transition: all 200ms ease-out;
    }
  }

  @media (min-width: 768px) {
    main {
      margin-top: 8rem;
      margin-bottom: 12rem;
    }

    .intro {
      margin-bottom: 4rem;
    }

    .section {
      margin-top: 8rem;
    }

    .columns {
      flex-direction: row;
      align-items: flex-start;
    }

    .column {
      width: unset;
      flex: 0;
      flex-basis: 40%;
    }
  }
</style>
