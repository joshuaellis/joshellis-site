---
import { DoubleArrowLeftIcon } from '@radix-ui/react-icons'

import Base from './Base.astro'
import { ExperimentActions } from '../components/ExperimentActions'

interface Link {
  title: string
  href: string
}

interface Props {
  title: string
  description: string
  date: string
  experimentName: string
  previous?: Link
  next?: Link
  class?: string
}

const {
  title,
  description,
  date,
  experimentName,
  previous,
  next,
  class: mainClass,
} = Astro.props
---

<Base title={title} description={description}>
  <div class="root">
    <aside>
      <a href="/" class="home t-XXS">
        <DoubleArrowLeftIcon />
        <span>home</span>
      </a>
    </aside>
    <header>
      <div class="titles">
        <h1 class="heading t-M">{title}</h1>
        <h2 class="heading t-XXS muted">{date}</h2>
      </div>
      <ExperimentActions client:idle experimentName={experimentName} />
    </header>
    <main class={mainClass}>
      <slot />
    </main>
    <footer>
      <div class="divider" aria-hidden="true"></div>
      <nav>
        {
          previous ? (
            <a href={previous.href} class="footer-link">
              <span class="t-XXS muted">Previous</span>
              <span class="t-XXS link-regular">{previous.title}</span>
            </a>
          ) : (
            <div />
          )
        }
        {
          next && (
            <a href={next.href} class="footer-link next">
              <span class="t-XXS muted">Next</span>
              <span class="t-XXS link-regular">{next.title}</span>
            </a>
          )
        }
      </nav>
    </footer>
  </div>
</Base>

<style>
  .root {
    width: 100%;
    display: grid;
    row-gap: 2rem;
    column-gap: 1rem;
    padding: 0 4rem;
    margin-top: 4rem;
    margin-bottom: 6rem;
    grid-template-rows: auto auto 1fr auto;
    grid-template-columns: 1fr;
  }

  aside {
    grid-row: 1 / 2;
    grid-column: 1 / 2;
  }

  .home {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    opacity: 0.6;
  }

  .home span {
    position: relative;
    bottom: 1px;
  }

  header {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    grid-row: 2 / 3;
    grid-column: 1 / 2;
  }

  .titles {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .muted {
    opacity: 0.6;
  }

  main {
    grid-row: 3 / 4;
    grid-column: 1 / 2;
    border: 1px solid rgba(250, 250, 250, 0.2);
    border-radius: var(--r8);
    background-color: rgba(0, 0, 0, 0.2);
    overflow: hidden;
  }

  footer {
    grid-row: 4 / 5;
    grid-column: 1 / 2;
    margin-top: 2rem;
  }

  .divider {
    width: 100%;
    height: 1px;
    background-color: rgba(250, 250, 250, 0.2);
  }

  nav {
    display: flex;
    justify-content: space-between;
    width: 100%;
    margin-top: 2rem;
  }

  .footer-link {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .footer-link.next {
    align-items: flex-end;
  }

  @media (hover: hover) {
    .footer-link:hover > span {
      text-decoration-color: rgba(250, 250, 250, 0.8);
    }
  }

  @media (min-width: 768px) {
    .root {
      max-width: 120rem;
      margin: 8rem auto 12rem;
      grid-template-columns: 1fr 4fr 1fr;
      grid-template-rows: auto 1fr auto;
      row-gap: 4rem;
      column-gap: 2rem;
    }

    aside {
      grid-row: 1 / 4;
    }

    header {
      grid-column: 2 / 3;
      grid-row: 1 / 2;
    }

    main {
      grid-column: 2 / 3;
      grid-row: 2 / 3;
    }

    footer {
      margin-top: 4rem;
      grid-column: 2 / 3;
      grid-row: 3 / 4;
    }

    nav {
      margin-top: 4rem;
    }
  }
</style>
